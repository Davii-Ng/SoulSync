        <mxCell id="voice" value="&lt;b&gt;voice_agent.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;ElevenLabs TTS + Scribe STT utility · called by the backend directly, not a sub-agent&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#3F2B4A;dashed=1;" vertex="1" parent="1">

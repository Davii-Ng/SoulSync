        <mxCell id="a4" value="&lt;b style=&quot;font-size:14px&quot;&gt;resource_agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Steps in when someone is struggling&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; face=&quot;Courier New&quot;&gt;get_crisis_resources()&lt;br&gt;get_therapist_resources()&lt;br&gt;get_mindfulness_exercise()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#5E1E1C;arcSize=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">

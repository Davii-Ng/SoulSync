<mxfile host="drawio" version="26.0.0">
  <diagram name="Agent Topology">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="root" value="&lt;b&gt;root_agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Google ADK orchestrator · agent.py · no tools&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A6F8E;strokeColor=#1B4B61;fontColor=#FFFFFF;fontSize=14;arcSize=20;" vertex="1" parent="1">
          <mxGeometry x="410" y="40" width="320" height="70" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="&lt;b style=&quot;font-size:14px&quot;&gt;core_companion_agent&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Hears the feeling behind the words&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; face=&quot;Courier New&quot;&gt;analyze_emotion()&lt;br&gt;suggest_resource()&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4E2FA;strokeColor=#5B7FC4;fontColor=#1E3A6B;arcSize=8;verticalAlign=top;spacingTop=8;" vertex="1" parent="1">
